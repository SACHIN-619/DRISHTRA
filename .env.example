# ==============================================================================
# DRISHTRA - Digital Reliability & Integrity Shield for Trusted AI
# Environment Configuration & Secret Manifest
# Smart India Hackathon 2026 | Problem Statement: SIH26228
# Ministry of Defence | Indian Army (DGIS)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RUNTIME & DEPLOYMENT ENVIRONMENT
# ------------------------------------------------------------------------------
# Options:
#  - "air-gapped-development" (Local testing, full debug, air-gapped isolation)
#  - "air-gapped-production"  (Hardened defence deployment on on-premise hardware)
#  - "render-demo"            (Public cloud demonstration on Render using synthetic data)
ENVIRONMENT=air-gapped-development

# Set to "true" for strict offline operation (blocks all external HTTP/LLM calls)
# Set to "false" if you wish to enable the optional Grok LLM debrief API
IS_AIR_GAPPED=true

# Server Network Bindings
HOST=0.0.0.0
PORT=8000

# ------------------------------------------------------------------------------
# 2. SECURITY & AUTHENTICATION (RBAC & JWT)
# ------------------------------------------------------------------------------
# Sovereign secret key for cryptographic JWT signing and analyst sessions
SECRET_KEY=drishtra-sovereign-defence-assurance-secret-key-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (SQLITE OR NEON.TECH POSTGRESQL)
# ------------------------------------------------------------------------------
# DEFAULT (Air-Gapped Sovereign Vault):
DATABASE_URL=sqlite:///./drishtra_vault.db

# OPTIONAL CLOUD POSTGRESQL (e.g., Neon.tech, AWS RDS, Render PostgreSQL):
# If using Neon.tech, paste your connection string here. Both 'postgres://' and 
# 'postgresql://' formats are automatically normalized by DRISHTRA.
# DATABASE_URL=postgresql://user:password@ep-xyz-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# 4. OPTIONAL TACTICAL AI EXPLAINER (GROK / xAI API)
# ------------------------------------------------------------------------------
# DRISHTRA's computer vision and cryptographic assurance engines operate 100% 
# OFFLINE without any LLM dependency.
#
# If provided, Grok synthesizes natural language tactical incident briefs
# via POST /api/v1/cases/{case_id}/ai-debrief.
# When omitted or when IS_AIR_GAPPED=true, DRISHTRA automatically falls back to 
# its built-in sovereign offline rule synthesizer.
GROK_API_KEY=
GROK_API_BASE=https://api.x.ai/v1
GROK_MODEL=grok-2-latest

# ------------------------------------------------------------------------------
# 5. LOCAL STORAGE DIRECTORIES
# ------------------------------------------------------------------------------
BASE_STORAGE_DIR=./storage
