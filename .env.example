# DRISHTRA configuration. Copy to .env and adjust. Nothing here is required for a demo.

# --- Runtime -----------------------------------------------------------------
ENVIRONMENT=air-gapped-development
IS_AIR_GAPPED=true          # true blocks the optional external explainer entirely
HOST=127.0.0.1
PORT=8000

# --- Identity & sessions -------------------------------------------------------
# Leave SECRET_KEY empty to let DRISHTRA generate a per-install secret in storage/keys/.
# Never reuse a value that has been published anywhere (the old repository default is refused).
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=480

# DEMO_MODE seeds synthetic cases and one account per role (password Drishtra@2026).
# Set to false for any real use.
DEMO_MODE=true
BOOTSTRAP_ADMIN_USERNAME=admin
# If empty (and DEMO_MODE=false) a random password is written once to storage/keys/initial_admin_password.txt
BOOTSTRAP_ADMIN_PASSWORD=
PASSWORD_MIN_LENGTH=10
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# --- Storage -----------------------------------------------------------------
DATABASE_URL=sqlite:///./drishtra_vault.db
# PostgreSQL / Neon (not air-gapped; needs: pip install psycopg2-binary; check with scripts/check_database.py):
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# DRISHTRA_ALLOW_SQLITE_FALLBACK=false
BASE_STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=2048

# --- Optional explanation layer (never needed by the assurance core) -----------
# Sends case findings to an external LLM. Only used if ALL of: key set,
# ALLOW_EXTERNAL_EXPLAINER=true and IS_AIR_GAPPED=false.
ALLOW_EXTERNAL_EXPLAINER=false
GROK_API_KEY=
