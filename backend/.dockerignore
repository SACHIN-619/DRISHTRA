.git
.gitignore
.env
*.env
.pytest_cache
__pycache__
*.pyc
*.pyo
*.pyd
*.db
*.sqlite
*.sqlite3
storage/artifacts/*
!storage/artifacts/.gitkeep
storage/audit/*
!storage/audit/.gitkeep
storage/manifests/*
!storage/manifests/.gitkeep
# never bake secrets, local vaults or dev clutter into an image
storage/keys
**/storage/keys
backend/storage
node_modules
**/node_modules
frontend
synthetic_datas
browser_artifacts
demo_video
temp_*
